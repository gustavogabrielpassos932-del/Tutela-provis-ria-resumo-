  { id: 5, cat: "geral", tag: "Art. 299", q: "Quando requerida em caráter antecedente, a tutela provisória deve ser endereçada:", opts: ["Sempre ao STJ.", "Ao juízo competente para conhecer do pedido principal.", "A qualquer vara cível por livre escolha.", "Exclusivamente ao Juizado Especial.", "Ao juízo do domicílio do advogado."], ans: 1, exp: "Art. 299, caput: '...quando antecedente, ao juízo competente para conhecer do pedido principal.'." },
  { id: 6, cat: "geral", tag: "Art. 299, p.ú.", q: "Nos recursos e nas ações de competência originária de tribunal, a tutela provisória será requerida:", opts: ["Sempre ao juiz de 1º grau.", "Ao órgão jurisdicional competente para apreciar o mérito.", "Ao Ministério Público.", "Ao escrivão da vara de origem.", "Apenas em ação autônoma."], ans: 1, exp: "Art. 299, parágrafo único: compete ao órgão jurisdicional competente para apreciar o mérito (em regra, o relator — art. 932, II)." },
  { id: 7, cat: "geral", tag: "Art. 297", q: "Na efetivação da tutela provisória, segundo o art. 297 do CPC:", opts: ["É vedada a fixação de multa diária (astreintes).", "O juiz pode determinar as medidas adequadas, observando, no que couber, o cumprimento provisório da sentença.", "É vedada contra a Fazenda Pública em qualquer hipótese.", "Só cabe busca e apreensão.", "Exige trânsito em julgado prévio."], ans: 1, exp: "Art. 297, caput e parágrafo único: confere poder geral de efetivação ao juiz, inclusive com astreintes contra a Fazenda (STJ)." },
  { id: 8, cat: "geral", tag: "Fungibilidade", q: "O art. 305, parágrafo único, consagra a fungibilidade entre as tutelas provisórias. Segundo a doutrina e o STJ, essa fungibilidade é:", opts: ["Apenas da cautelar para a antecipada.", "De mão dupla (ampla), entre cautelar e antecipada e estendida à evidência.", "Vedada pelo CPC/2015.", "Permitida só após a sentença.", "Restrita ao processo penal."], ans: 1, exp: "O STJ (AgRg no REsp 1.103.299/BA) e a doutrina (Donizetti) reconhecem a fungibilidade plena/de mão dupla." },
  { id: 9, cat: "geral", tag: "Fazenda Pública", q: "Sobre tutela provisória contra a Fazenda Pública, o STF decidiu na Súmula 729 e na ADI 4296 que:", opts: ["É absolutamente proibida em matéria previdenciária.", "As vedações da ADC 4 não se aplicam a benefícios previdenciários (Súmula 729), e é inconstitucional a vedação absoluta do art. 7º, § 2º, da Lei 12.016/2009 (ADI 4296).", "Aplica-se apenas a municípios.", "Depende de aprovação do Congresso Nacional.", "Só cabe após precatório."], ans: 1, exp: "Súmula 729/STF afasta a restrição da ADC 4 em causas previdenciárias; ADI 4296/STF derrubou a proibição geral de liminar no Mandado de Segurança." },
  { id: 10, cat: "geral", tag: "Cognição", q: "Qual é a diferença estrutural entre tutela provisória e tutela definitiva?", opts: ["A tutela provisória funda-se em cognição sumária (probabilidade) e é precária; a definitiva funda-se em cognição exauriente (certeza) e forma coisa julgada.", "Ambas fazem coisa julgada material.", "A definitiva é sempre liminar.", "A provisória nunca antecipa o mérito.", "Não há diferença técnica no CPC/2015."], ans: 0, exp: "Tutela provisória = cognição sumária + precariedade (art. 296); tutela definitiva = cognição exauriente + aptidão à coisa julgada." },

  // 11-24: URGÊNCIA E CAUTELAR
  { id: 11, cat: "urgencia", tag: "Art. 300", q: "Quais são os dois requisitos cumulativos para a concessão da tutela de urgência (art. 300, caput)?", opts: ["Coisa julgada e trânsito em julgado.", "Probabilidade do direito (fumus boni iuris) e perigo de dano ou risco ao resultado útil do processo (periculum in mora).", "Abuso do direito de defesa e contrato de depósito.", "Revelia do réu e audiência de conciliação.", "Certeza absoluta e caução obrigatória."], ans: 1, exp: "Art. 300, caput, do CPC exige probabilidade do direito + perigo de dano ou risco ao resultado útil do processo." },
  { id: 12, cat: "urgencia", tag: "Escala", q: "Na escala didática do Prof. Guilherme Hartmann, qual percentual mínimo de probabilidade autoriza a tutela de urgência?", opts: ["10%.", "50% (dúvida).", "51% (superar a dúvida).", "90%.", "100%."], ans: 2, exp: "50% é dúvida; a partir de 51% já há probabilidade do direito suficiente para a tutela de urgência (com periculum in mora)." },
  { id: 13, cat: "urgencia", tag: "Caução / STJ", q: "Segundo a 4ª Turma do STJ (REsp 1.837.156, 2025), o deferimento da gratuidade de justiça ao autor:", opts: ["Dispensa automaticamente a caução do art. 300, § 1º.", "Não afasta automaticamente a obrigatoriedade da caução, devendo o juiz analisar o caso concreto.", "Proíbe a concessão de tutela de urgência.", "Obriga o réu a pagar caução.", "Converte a tutela em evidência."], ans: 1, exp: "O art. 300, § 1º diz 'podendo a caução ser dispensada'; o STJ firmou que a gratuidade não gera dispensa automática." },
  { id: 14, cat: "urgencia", tag: "Serasa / STJ", q: "Nos Temas 31 a 34 do STJ (REsp 1.061.530/RS), a exclusão liminar do nome do devedor de cadastros restritivos (SPC/Serasa) exige:", opts: ["Apenas pedido simples na inicial.", "Questionamento do débito, aparência do bom direito em jurisprudência do STF/STJ e depósito do incontroverso ou caução idônea.", "Sentença transitada em julgado.", "Apenas boletim de ocorrência.", "Concordância do banco."], ans: 1, exp: "Os três requisitos cumulativos foram fixados pelo STJ em recurso repetitivo para evitar liminares sem lastro." },
  { id: 15, cat: "urgencia", tag: "Art. 300, § 2º", q: "Quando a prova documental inicial for insuficiente para demonstrar a urgência ou probabilidade na tutela de urgência, o juiz pode:", opts: ["Designar audiência de justificação prévia.", "Extinguir imediatamente sem mérito.", "Aplicar multa de 20% ao autor.", "Deferir por tutela de evidência.", "Remeter ao tribunal."], ans: 0, exp: "Art. 300, § 2º: 'A tutela de urgência pode ser concedida liminarmente ou após justificação prévia.'." },
  { id: 16, cat: "urgencia", tag: "Art. 300, § 3º", q: "A vedação à concessão de tutela antecipada quando houver perigo de irreversibilidade (art. 300, § 3º) é mitigada pela jurisprudência quando:", opts: ["O réu for revel.", "Houver conflito de irreversibilidades (ex.: risco à vida/saúde/alimentos vs. patrimônio), aplicando-se a ponderação (Enunciado 25/ENFAM e 40/CJF).", "O valor da causa for menor que 20 salários mínimos.", "A ação for monitória.", "Houver contrato de depósito."], ans: 1, exp: "Enunciado 25/ENFAM e Enunciado 40/CJF autorizam superar a vedação quando a não concessão causar lesão irreversível a direito fundamental mais valioso." },
  { id: 17, cat: "urgencia", tag: "Art. 302", q: "Segundo o STJ, a responsabilidade civil da parte que obteve tutela de urgência posteriormente revogada (art. 302) tem natureza:", opts: ["Subjetiva, exigindo prova de dolo.", "Objetiva (teoria do risco-proveito), liquidada nos próprios autos sempre que possível.", "Inexistente se houve advogado.", "Penal.", "Restrita a causas tributárias."], ans: 1, exp: "STJ (REsp 1.191.262/DF; REsp 1.770.124/SP): responsabilidade objetiva ex lege, liquidada nos próprios autos (art. 302, parágrafo único)." },
  { id: 18, cat: "urgencia", tag: "Tema 692 STJ", q: "Pelo Tema Repetitivo 692 do STJ, reformada tutela antecipada que concedeu benefício previdenciário/assistencial:", opts: ["Os valores recebidos são irrepetíveis em qualquer caso.", "O beneficiário deve devolver os valores recebidos indevidamente (art. 302, III), admitido desconto parcelado de até 30% no benefício ativo.", "Apenas o advogado devolve.", "O INSS suporta o prejuízo integralmente.", "Depende de ação rescisória."], ans: 1, exp: "Tema 692/STJ (Pet 12.482/DF): dever de devolução mediante desconto parcelado na folha (até 30% conforme Lei 8.213/91)." },
  { id: 19, cat: "urgencia", tag: "Art. 301", q: "Sobre o arresto e o sequestro como medidas cautelares exemplificativas do art. 301 do CPC:", opts: ["Ambos entregam o bem em definitivo.", "O arresto recai sobre patrimônio indeterminado para garantir futura execução por quantia; o sequestro recai sobre bem determinado e litigioso.", "O sequestro só existe no processo penal.", "O arresto exige sentença transitada em julgado.", "São sinônimos absolutos."], ans: 1, exp: "Arresto = garantia de execução por quantia certa (bens indeterminados); sequestro = preservação de coisa certa disputada em juízo." },
  { id: 20, cat: "urgencia", tag: "Art. 301", q: "O registro de protesto contra alienação de bens (art. 301), segundo o STJ:", opts: ["Impede juridicamente a venda do imóvel e torna nulo o contrato.", "Dá publicidade a terceiros da existência de litígio, afastando a boa-fé do adquirente, mas não impede a alienação.", "Equivale à penhora definitiva.", "Só cabe em inventário.", "Independe de decisão judicial."], ans: 1, exp: "STJ (REsp 1.229.449/MG): o protesto contra alienação não proíbe a venda, apenas afasta a alegação de desconhecimento/boa-fé de terceiros." },
  { id: 21, cat: "urgencia", tag: "Art. 306", q: "Na tutela cautelar requerida em caráter antecedente (art. 306), qual é o prazo para o réu contestar o pedido cautelar após ser citado?", opts: ["15 dias.", "5 dias.", "30 dias.", "10 dias.", "48 horas."], ans: 1, exp: "Art. 306 do CPC: 'O réu será citado para, no prazo de 5 (cinco) dias, contestar o pedido e indicar as provas que pretende produzir.'." },
  { id: 22, cat: "urgencia", tag: "Art. 308 / STJ", q: "Efetivada a tutela cautelar antecedente, o autor deve formular o pedido principal no prazo de 30 dias (art. 308). Segundo a Corte Especial do STJ (EREsp 2.066.868/SP, 2024), esse prazo conta-se:", opts: ["Em dias corridos, da concessão da liminar.", "Em dias úteis (art. 219), a partir da completa efetivação da medida cautelar.", "Em dias corridos, da citação do réu.", "Em meses.", "Apenas após a contestação."], ans: 1, exp: "A Corte Especial do STJ firmou que o prazo de 30 dias do art. 308 é processual (dias úteis) e inicia-se da efetivação integral da cautelar." },
  { id: 23, cat: "urgencia", tag: "Art. 309", q: "Cessada a eficácia da tutela cautelar antecedente (art. 309, parágrafo único), é lícito ao autor renovar o pedido cautelar?", opts: ["Sim, livremente com os mesmos fundamentos.", "Não, é vedado renovar o pedido, salvo sob novo fundamento.", "Sim, após 5 dias.", "Sim, pagando novas custas.", "Apenas em outro estado."], ans: 1, exp: "Art. 309, parágrafo único: 'Se por qualquer motivo cessar a eficácia da tutela cautelar, é vedado à parte renovar o pedido, salvo sob novo fundamento.'." },
  { id: 24, cat: "urgencia", tag: "Art. 310", q: "O indeferimento da tutela cautelar impede a parte de formular o pedido principal (art. 310)?", opts: ["Sim, sempre faz coisa julgada.", "Não, salvo se o motivo do indeferimento for o reconhecimento de decadência ou de prescrição.", "Sim, se houver revelia.", "Sim, se o réu contestar em 5 dias.", "Não, em nenhuma hipótese, mesmo havendo prescrição."], ans: 1, exp: "Art. 310 do CPC: o indeferimento da cautelar não obsta o pedido principal, exceto quando reconhecer decadência ou prescrição." },

  // 25-36: ANTECIPADA ANTECEDENTE E ESTABILIZAÇÃO
  { id: 25, cat: "estab", tag: "Art. 303", q: "Na petição inicial da tutela antecipada em caráter antecedente (art. 303), o autor deve indicar:", opts: ["Apenas o pedido liminar, sem mencionar o pedido final.", "O requerimento da tutela antecipada, a indicação do pedido de tutela final, o valor da causa considerando o pedido final e a opção expressa pelo benefício do art. 303, § 5º.", "Apenas a qualificação das partes.", "Provas periciais já concluídas.", "Caução em dinheiro obrigatória."], ans: 1, exp: "Art. 303, caput, §§ 4º e 5º do CPC exigem indicação do pedido final, valor da causa correspondente e menção expressa ao benefício." },
  { id: 26, cat: "estab", tag: "Art. 303, § 1º", q: "Concedida a tutela antecipada antecedente, qual o prazo padrão para o autor aditar a inicial (art. 303, § 1º, I)?", opts: ["5 dias.", "15 dias (ou outro prazo maior fixado pelo juiz), nos mesmos autos e sem novas custas.", "30 dias corridos.", "48 horas.", "60 dias."], ans: 1, exp: "Art. 303, § 1º, I e § 3º: prazo de 15 dias (ou maior fixado pelo juiz), nos mesmos autos e sem novas custas." },
  { id: 27, cat: "estab", tag: "Art. 303, § 6º", q: "Se o juiz entender que NÃO há elementos para conceder a tutela antecipada antecedente (art. 303, § 6º):", opts: ["Indefere imediatamente e condena em multa.", "Determina a emenda da petição inicial em até 5 dias, sob pena de indeferimento e extinção sem mérito.", "Converte em tutela de evidência.", "Cita o réu para contestar em 5 dias.", "Remete ao tribunal."], ans: 1, exp: "Art. 303, § 6º: prazo de até 5 dias para emenda, sob pena de indeferimento e extinção sem resolução do mérito." },
  { id: 28, cat: "estab", tag: "Art. 303, § 2º", q: "Concedida a tutela antecipada antecedente, se o autor não realizar o aditamento no prazo legal (e o réu tiver recorrido):", opts: ["A tutela se estabiliza a favor do autor.", "O processo é extinto sem resolução do mérito e a liminar perde eficácia.", "O juiz julga procedente o pedido final.", "O réu paga honorários de 5%.", "Suspende-se o feito por 2 anos."], ans: 1, exp: "Art. 303, § 2º: 'Não realizado o aditamento a que se refere o inciso I do § 1º deste artigo, o processo será extinto sem resolução do mérito.'." },
  { id: 29, cat: "estab", tag: "STJ Prazos", q: "Sobre a ordem de contagem dos prazos do réu (para recorrer) e do autor (para aditar) na tutela antecipada antecedente, o STJ (2020/2024) firmou que:", opts: ["São prazos simultâneos que correm juntos da concessão da liminar.", "São prazos sucessivos: primeiro corre o prazo do réu após sua citação; apenas se o réu impugnar abre-se o prazo de 15 dias para o autor aditar.", "O autor adita antes mesmo de distribuir a inicial.", "O réu não precisa ser citado.", "Não existe prazo para o réu."], ans: 1, exp: "O STJ consolidou a sucessividade dos prazos para não forçar o autor a aditar antes de saber se haverá estabilização pela inércia do réu." },
  { id: 30, cat: "estab", tag: "Art. 218, § 4º", q: "Se o autor apresentar o aditamento da inicial antes mesmo de ser intimado do recurso do réu:", opts: ["O aditamento é intempestivo (nulo).", "É plenamente válido e tempestivo, nos termos do art. 218, § 4º, do CPC.", "Gera multa por litigância de má-fé.", "Impede a citação do réu.", "Extingue o processo."], ans: 1, exp: "Art. 218, § 4º, do CPC: 'Será considerado tempestivo o ato praticado antes do termo inicial do prazo.'." },
  { id: 31, cat: "estab", tag: "STJ Divergência", q: "Para impedir a estabilização da tutela antecipada antecedente (art. 304), qual é a posição MAJORITÁRIA do STJ (3ª e 4ª Turmas)?", opts: ["Somente o agravo de instrumento impede a estabilização.", "Qualquer manifestação de inconformismo tempestiva do réu — inclusive a contestação — impede a estabilização.", "Apenas embargos de declaração impedem.", "Nem recurso nem contestação impedem.", "Somente ação rescisória impede."], ans: 1, exp: "A 3ª e a 4ª Turmas (REsp 1.760.966/SP; REsp 1.938.645/CE) adotam interpretação ampliativa: contestação ou outra impugnação idônea evita a estabilização." },
  { id: 32, cat: "estab", tag: "1ª Turma STJ", q: "Qual é a posição da 1ª Turma do STJ (REsp 1.797.365/RS) e de Elpídio Donizetti sobre o art. 304?", opts: ["Contestação impede a estabilização.", "Interpretação literal/restritiva: apenas a interposição do recurso cabível (agravo de instrumento) impede a estabilização.", "Não existe estabilização no CPC.", "A estabilização só vale para cautelares.", "Basta petição simples após 2 anos."], ans: 1, exp: "A 1ª Turma do STJ e Donizetti seguem a literalidade do art. 304 ('não for interposto o respectivo recurso')." },
  { id: 33, cat: "estab", tag: "Art. 304, § 6º", q: "Sobre a relação entre estabilização da tutela antecipada (art. 304) e coisa julgada material:", opts: ["A decisão estabilizada forma coisa julgada material imediata, cabendo ação rescisória.", "A decisão que concede a tutela NÃO faz coisa julgada (§ 6º), descabendo ação rescisória (Enunciado 33/FPPC).", "Faz coisa julgada apenas contra o autor.", "Só faz coisa julgada em ações de família.", "Converte-se em súmula vinculante."], ans: 1, exp: "Art. 304, § 6º: 'A decisão que concede a tutela não fará coisa julgada...'. Logo, não cabe ação rescisória (art. 966), mas sim a ação revisional do § 2º." },
  { id: 34, cat: "estab", tag: "Art. 304, § 5º", q: "Qual é o prazo para propor a ação autônoma visando rever, reformar ou invalidar a tutela antecipada estabilizada?", opts: ["15 dias úteis.", "2 anos (decadencial), contados da ciência da decisão que extinguiu o processo.", "5 anos prescricionais.", "30 dias.", "Imprescritível."], ans: 1, exp: "Art. 304, § 5º: extingue-se após 2 anos, contados da ciência da decisão extintiva (art. 304, § 1º), perante o juízo prevento (§ 4º)." },
  { id: 35, cat: "estab", tag: "Honorários STJ", q: "Ocorrendo a estabilização da tutela antecipada e extinção do processo (art. 304, § 1º), os honorários advocatícios são fixados pelo STJ (REsp 1.895.663/PR) em:", opts: ["20% sobre o valor da condenação.", "5% sobre o valor da causa, por analogia ao art. 701 do CPC (ação monitória).", "Zero (cada parte arca com seus custos).", "1% fixo.", "Salário mínimo fixo."], ans: 1, exp: "A 3ª Turma do STJ aplicou analogicamente o art. 701 do CPC, fixando honorários de 5% diante da rápida solução sem instrução." },
  { id: 36, cat: "estab", tag: "Sem Citação", q: "Se o autor obteve a liminar do art. 303, mas o réu ainda NÃO foi citado:", opts: ["Já ocorre a estabilização em 15 dias.", "Não pode ocorrer estabilização nem fluência de prazo recursal contra o réu antes de sua citação válida.", "O juiz extingue o feito com mérito.", "O autor é condenado por má-fé.", "Converte-se em cautelar."], ans: 1, exp: "Sem citação válida não se forma a relação angular nem corre o prazo de recurso para o réu." },

  // 37-50: EVIDÊNCIA E RECURSOS
  { id: 37, cat: "evidencia", tag: "Art. 311", q: "Na tutela de evidência (art. 311 do CPC), qual requisito da tutela de urgência é expressamente dispensado?", opts: ["Probabilidade do direito.", "Demonstração de perigo de dano ou de risco ao resultado útil do processo (periculum in mora).", "Motivação da decisão.", "Capacidade postulatória.", "Competência do juízo."], ans: 1, exp: "Art. 311, caput: concedida 'independentemente da demonstração de perigo de dano ou de risco ao resultado útil do processo'." },
  { id: 38, cat: "evidencia", tag: "Liminaridade", q: "Em quais incisos do art. 311 do CPC o juiz pode decidir liminarmente (inaudita altera parte)?", opts: ["Nos incisos I e IV.", "Nos incisos II e III (art. 311, parágrafo único e art. 9º, parágrafo único, II).", "Em todos os incisos.", "Apenas no inciso I.", "Em nenhum."], ans: 1, exp: "Art. 311, parágrafo único: apenas nas hipóteses dos incisos II (documental + tese repetitiva/SV) e III (contrato de depósito)." },
  { id: 39, cat: "evidencia", tag: "Inciso I / STJ", q: "Segundo o STJ (2022) e o Enunciado 47/CJF, a tutela de evidência do art. 311, I exige:", opts: ["Apenas conduta protelatória do réu.", "Cumulativamente o abuso/propósito protelatório do réu E a verossimilhança do direito alegado pelo autor.", "Apenas revelia.", "Apenas caução real.", "Testemunha no exterior."], ans: 1, exp: "Não basta a chicana processual do réu; é indispensável a verossimilhança/probabilidade do direito do autor." },
  { id: 40, cat: "evidencia", tag: "Inciso II / CJF", q: "Os Enunciados 48/CJF e 30–31/ENFAM ampliam o art. 311, II para abranger também:", opts: ["Sentenças de 1º grau sem recurso.", "Repercussão Geral do STF, IAC, controle concentrado (ADI/ADC/ADPF) e súmulas do STJ/STF, independentemente do trânsito em julgado do paradigma.", "Apenas pareceres doutrinários.", "Apenas súmulas de tribunais arbitrais.", "Somente decisões transitadas há mais de 5 anos."], ans: 1, exp: "Enunciado 48/CJF + Enunciados 30 e 31/ENFAM estendem o inciso II aos demais precedentes qualificados e dispensam o trânsito em julgado do paradigma." },
  { id: 41, cat: "evidencia", tag: "Inciso III", q: "No art. 311, III (pedido reipersecutório fundado em prova documental do contrato de depósito), o juiz decreta:", opts: ["Prisão civil do depositário infiel.", "Ordem de entrega do objeto custodiado, sob cominação de multa.", "Perda automática de bens imóveis.", "Suspensão por 1 ano.", "Indenização moral imediata."], ans: 1, exp: "Art. 311, III determina a ordem de entrega do objeto custodiado sob cominação de multa (vedada prisão pela Súmula Vinculante 25)." },
  { id: 42, cat: "evidencia", tag: "Inciso IV", q: "Por que o art. 311, IV não admite decisão liminar inaudita altera parte?", opts: ["Porque exige que o réu seja citado e tenha oportunidade de opor (ou não) prova capaz de gerar dúvida razoável.", "Porque exige perícia obrigatória.", "Porque se aplica só a execuções fiscais.", "Porque é tutela cautelar.", "Porque depende de caução."], ans: 0, exp: "Sem ouvir o réu, não é possível verificar se ele opõe ou não prova capaz de gerar dúvida razoável." },
  { id: 43, cat: "evidencia", tag: "Rol / Monitória", q: "O art. 701 do CPC (ação monitória) prevê hipótese de tutela da evidência fora do art. 311, estabelecendo prazo de cumprimento de:", opts: ["5 dias, sem honorários.", "15 dias, com honorários de 5% do valor atribuído à causa (e isenção de custas se cumprido no prazo).", "30 dias, com honorários de 20%.", "10 dias.", "48 horas."], ans: 1, exp: "Art. 701, caput e § 1º do CPC: 15 dias para cumprimento, honorários de 5% e isenção de custas." },
  { id: 44, cat: "evidencia", tag: "Prática", q: "Em processo de inventário, segundo julgado citado na aula, cabe tutela de evidência para antecipar o uso/fruição de bem hereditário quando:", opts: ["Todos os herdeiros brigarem judicialmente.", "Não houver controvérsia ou oposição dos demais herdeiros, reservando-se a partilha definitiva para a sentença.", "Houver dívida fiscal pendente sem garantia.", "O bem já tiver sido vendido a terceiro.", "O espólio for insolvente."], ans: 1, exp: "Ausente oposição entre os herdeiros, admite-se a fruição antecipada por evidência até a partilha final." },
  { id: 45, cat: "evidencia", tag: "Divórcio Liminar", q: "No debate sobre o divórcio liminar (direito potestativo incondicionado), qual enunciado do IBDFAM admite excepcionalmente sua concessão?", opts: ["Enunciado 10.", "Enunciado 46 do IBDFAM (sobretudo quando há dificuldade na citação do cônjuge).", "Enunciado 90.", "Enunciado 12.", "Nenhum enunciado."], ans: 1, exp: "Enunciado 46/IBDFAM fundamenta a corrente favorável excepcional (dignidade humana e personalidade), em oposição à corrente que exige contraditório prévio (art. 9º)." },
  { id: 46, cat: "evidencia", tag: "Momento", q: "Diferentemente da tutela de urgência, a tutela provisória de evidência é:", opts: ["Sempre antecedente.", "Sempre incidental e sempre satisfativa.", "Cautelar ou satisfativa.", "Sujeita à estabilização do art. 304.", "Dependente de justificação prévia."], ans: 1, exp: "Não existe tutela de evidência antecedente nem cautelar; é sempre incidental (inclusive na inicial completa) e satisfativa." },
