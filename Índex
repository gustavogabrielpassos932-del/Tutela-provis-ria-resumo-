];

const letters = ["A", "B", "C", "D", "E"];
const state = {};
let activeFilter = "all";

const quizContainer = document.getElementById("quiz-container");
const scoreOkEl = document.getElementById("score-ok");
const scoreErrEl = document.getElementById("score-err");
const scorePctEl = document.getElementById("score-pct");
const scoreAnsEl = document.getElementById("score-answered");

function updateScore() {
  const totalAns = Object.keys(state).length;
  let ok = 0, err = 0;
  for (const [id, choice] of Object.entries(state)) {
    const q = QUESTIONS.find(x => x.id === Number(id));
    if (choice === q.ans) ok++; else err++;
  }
  scoreOkEl.textContent = ok;
  scoreErrEl.textContent = err;
  scoreAnsEl.textContent = `${totalAns}/50`;
  scorePctEl.textContent = totalAns ? `${Math.round((ok / totalAns) * 100)}%` : "0%";
}

function renderQuiz() {
  quizContainer.innerHTML = "";
  const filtered = QUESTIONS.filter(q => {
    if (activeFilter === "all") return true;
    if (activeFilter === "wrong") return state[q.id] !== undefined && state[q.id] !== q.ans;
    return q.cat === activeFilter;
  });

  if (filtered.length === 0) {
    quizContainer.innerHTML = `<div class="callout callout-blue"><div class="callout-title">Nenhuma questão neste filtro</div><p style="margin:0;">Nenhuma questão corresponde ao filtro selecionado no momento.</p></div>`;
    return;
  }

  filtered.forEach(q => {
    const chosen = state[q.id];
    const isAnswered = chosen !== undefined;
    const card = document.createElement("div");
    card.className = "q-card" + (isAnswered ? (chosen === q.ans ? " answered-ok" : " answered-err") : "");

    const optsHtml = q.opts.map((opt, idx) => {
      let cls = "q-opt";
      if (isAnswered) {
        if (idx === q.ans) cls += " correct";
        else if (idx === chosen) cls += " wrong";
      }
      return `<button class="${cls}" data-qid="${q.id}" data-idx="${idx}" ${isAnswered ? "disabled" : ""}>
        <span class="opt-letter">${letters[idx]}</span>
        <span>${opt}</span>
      </button>`;
    }).join("");

    card.innerHTML = `
      <div class="q-meta">
        <span class="q-num">QUESTÃO ${String(q.id).padStart(2, "0")}</span>
        <span class="q-tag">${q.tag}</span>
      </div>
      <div class="q-stem">${q.q}</div>
      <div class="q-opts">${optsHtml}</div>
      <div class="q-feedback ${isAnswered ? "show" : ""}">
        <strong>Gabarito: ${letters[q.ans]}</strong> — ${q.exp}
      </div>
    `;
    quizContainer.appendChild(card);
  });

  quizContainer.querySelectorAll(".q-opt").forEach(btn => {
    btn.addEventListener("click", () => {
      const qid = Number(btn.dataset.qid);
      const idx = Number(btn.dataset.idx);
      state[qid] = idx;
      updateScore();
      renderQuiz();
    });
  });
}

document.querySelectorAll(".btn-filter").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll(".btn-filter").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    activeFilter = btn.dataset.filter;
    renderQuiz();
  });
});

document.getElementById("btn-reset").addEventListener("click", () => {
  for (const k of Object.keys(state)) delete state[k];
  updateScore();
  renderQuiz();
});

window.addEventListener("scroll", () => {
  const docH = document.documentElement.scrollHeight - window.innerHeight;
  const pct = docH > 0 ? (window.scrollY / docH) * 100 : 0;
  document.getElementById("read-progress").style.width = `${Math.min(100, Math.max(0, pct))}%`;

  const sections = document.querySelectorAll("section.section-card");
  let currentId = "";
  sections.forEach(sec => {
    if (window.scrollY >= sec.offsetTop - 160) currentId = sec.id;
  });
  document.querySelectorAll("#toc a").forEach(a => {
    a.classList.toggle("active", a.getAttribute("href") === `#${currentId}`);
  });
});

renderQuiz();
updateScore();
</script>
</body>
</html>
