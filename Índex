  { id: 48, cat: "evidencia", tag: "Perda de Objeto", q: "Se, na pendência de agravo de instrumento contra decisão de tutela provisória, o juiz de 1º grau proferir sentença de mérito:", opts: ["A sentença é nula por usurpação de competência.", "Em regra, ocorre a perda superveniente do objeto do agravo, pois a cognição sumária é substituída pela cognição exauriente.", "O agravo converte-se automaticamente em REsp.", "O tribunal deve julgar o agravo e anular a sentença.", "Suspende-se a sentença por 2 anos."], ans: 1, exp: "Tese consolidada no STJ: a tutela definitiva (sentença de mérito) substitui a tutela provisória, gerando prejudicialidade do agravo." },
  { id: 49, cat: "evidencia", tag: "Súmula 735 STF", q: "Qual é o entendimento sumulado pelo STF (aplicado por analogia pelo STJ) quanto a Recurso Extraordinário/Especial contra acórdão que defere ou indefere liminar?", opts: ["Sempre cabível com efeito suspensivo.", "Súmula 735/STF: não cabe RE contra acórdão que defere medida liminar (salvo violação direta aos requisitos legais).", "Só cabe se o valor superar 1.000 salários mínimos.", "Depende de caução em dobro.", "Cabe apenas via reclamação."], ans: 1, exp: "Súmula 735/STF: juízos precários não ensejam, em regra, recurso excepcional, salvo ofensa direta à lei federal disciplinadora do instituto." },
