<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tutelas Provisórias (Arts. 294 a 311 do CPC) — Material de Estudo &amp; 50 Questões</title>
<style>
  :root {
    --bg-void: #07070a;
    --bg-surface: #111319;
    --bg-elevated: #171a23;
    --border-subtle: rgba(255, 255, 255, 0.07);
    --border-strong: rgba(255, 255, 255, 0.14);
    --text-primary: #f1f5f9;
    --text-secondary: #a1acc2;
    --text-muted: #64748b;
    --accent-gold: #e5b869;
    --accent-gold-dim: rgba(229, 184, 105, 0.12);
    --accent-blue: #60a5fa;
    --accent-blue-dim: rgba(96, 165, 250, 0.12);
    --accent-emerald: #34d399;
    --accent-emerald-dim: rgba(52, 211, 153, 0.12);
    --accent-rose: #fb7185;
    --accent-rose-dim: rgba(251, 113, 133, 0.12);
    --accent-violet: #a78bfa;
    --accent-violet-dim: rgba(167, 139, 250, 0.12);
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --shadow-card: 0 12px 32px -12px rgba(0, 0, 0, 0.72);
    --font-sans: "Inter", "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    --font-serif: "Georgia", "Cambria", "Times New Roman", serif;
    --font-mono: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: radial-gradient(circle at 15% 0%, rgba(96,165,250,0.06), transparent 40%),
                radial-gradient(circle at 85% 12%, rgba(229,184,105,0.05), transparent 38%),
                var(--bg-void);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.7;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }

  #read-progress {
    position: fixed;
    top: 0; left: 0;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent-gold));
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  .app-shell {
    max-width: 1340px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 275px minmax(0, 1fr);
    gap: 28px;
    padding: 28px 24px 80px;
  }

  .sidebar {
    position: sticky;
    top: 24px;
    align-self: start;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 20px;
    box-shadow: var(--shadow-card);
  }
  .sidebar-brand {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-gold);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .sidebar-title {
    font-size: 1.04rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 16px;
    line-height: 1.35;
  }
  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 18px;
  }
  .nav-list a {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 11px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    transition: all 0.18s ease;
    border: 1px solid transparent;
  }
  .nav-list a:hover, .nav-list a.active {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border-color: var(--border-subtle);
  }
  .nav-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
    flex-shrink: 0;
  }
  .nav-list a.active .nav-dot { background: var(--accent-gold); }

  .sidebar-score {
    border-top: 1px solid var(--border-subtle);
    padding-top: 16px;
  }
  .score-label {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
  }
  .score-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .score-box {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px 6px;
    text-align: center;
  }
  .score-box .num {
    display: block;
    font-size: 1.08rem;
    font-weight: 700;
    font-family: var(--font-mono);
  }
  .score-box .lbl { font-size: 0.68rem; color: var(--text-muted); }
  .num.ok { color: var(--accent-emerald); }
  .num.err { color: var(--accent-rose); }
  .num.pct { color: var(--accent-gold); }

  .main-content { display: flex; flex-direction: column; gap: 26px; }

  .hero {
    background: linear-gradient(145deg, rgba(23,26,35,0.96), rgba(13,15,20,0.98));
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 34px 36px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .hero::after {
    content: "";
    position: absolute;
    top: -60px; right: -60px;
    width: 240px; height: 240px;
    background: radial-gradient(circle, rgba(229,184,105,0.14), transparent 70%);
    pointer-events: none;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .badge {
    font-size: 0.74rem;
    font-weight: 600;
    padding: 4px 11px;
    border-radius: 999px;
    letter-spacing: 0.03em;
    border: 1px solid transparent;
  }
  .badge-gold { background: var(--accent-gold-dim); color: var(--accent-gold); border-color: rgba(229,184,105,0.28); }
  .badge-blue { background: var(--accent-blue-dim); color: var(--accent-blue); border-color: rgba(96,165,250,0.28); }
  .badge-violet { background: var(--accent-violet-dim); color: var(--accent-violet); border-color: rgba(167,139,250,0.28); }
  .badge-emerald { background: var(--accent-emerald-dim); color: var(--accent-emerald); border-color: rgba(52,211,153,0.28); }
  .badge-rose { background: var(--accent-rose-dim); color: var(--accent-rose); border-color: rgba(251,113,133,0.28); }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 700;
    line-height: 1.22;
    color: #fff;
    margin-bottom: 12px;
  }
  .hero p { color: var(--text-secondary); font-size: 1rem; max-width: 75ch; }

  .section-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 30px 32px;
    box-shadow: var(--shadow-card);
  }
  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .section-num {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-gold);
    background: var(--accent-gold-dim);
    border: 1px solid rgba(229,184,105,0.25);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }
  .section-header h2 {
    font-size: 1.32rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  h3 { font-size: 1.08rem; color: #e2e8f0; margin: 22px 0 10px; font-weight: 650; }
  p { color: var(--text-secondary); margin-bottom: 12px; }
  strong { color: var(--text-primary); }
  ul.clean {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 10px 0 16px;
  }
  ul.clean li { position: relative; padding-left: 18px; color: var(--text-secondary); }
  ul.clean li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent-gold);
    font-weight: 700;
  }

  .lei-seca {
    background: linear-gradient(135deg, rgba(229,184,105,0.07), rgba(17,19,25,0.95));
    border: 1px solid rgba(229,184,105,0.26);
    border-left: 4px solid var(--accent-gold);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    margin: 16px 0;
  }
  .lei-seca-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-gold);
    margin-bottom: 8px;
  }
  .lei-seca blockquote {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: #e2e8f0;
    line-height: 1.66;
  }
  .lei-seca blockquote p { color: #e2e8f0; margin-bottom: 6px; }
  .lei-seca blockquote p:last-child { margin-bottom: 0; }

  .callout {
    border-radius: var(--radius-md);
    padding: 16px 20px;
    margin: 16px 0;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
  }
  .callout-blue { border-left: 4px solid var(--accent-blue); background: rgba(96,165,250,0.06); }
  .callout-emerald { border-left: 4px solid var(--accent-emerald); background: rgba(52,211,153,0.06); }
  .callout-rose { border-left: 4px solid var(--accent-rose); background: rgba(251,113,133,0.06); }
  .callout-title {
    font-size: 0.84rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }
  .callout-blue .callout-title { color: var(--accent-blue); }
  .callout-emerald .callout-title { color: var(--accent-emerald); }
  .callout-rose .callout-title { color: var(--accent-rose); }

  .tree-box {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: #cbd5e1;
    overflow-x: auto;
    line-height: 1.55;
    margin: 16px 0;
  }

  .scale-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 18px 0;
  }
  .scale-step {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 16px;
  }
  .scale-pct {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 6px;
    display: block;
  }
  .scale-step.s50 .scale-pct { color: var(--text-muted); }
  .scale-step.s51 .scale-pct { color: var(--accent-blue); }
  .scale-step.s90 .scale-pct { color: var(--accent-gold); }
  .scale-step.s100 .scale-pct { color: var(--accent-emerald); }
  .scale-step h4 { font-size: 0.92rem; color: var(--text-primary); margin-bottom: 4px; }
  .scale-step p { font-size: 0.82rem; margin: 0; line-height: 1.45; }

  .table-wrap {
    overflow-x: auto;
    margin: 16px 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }
  table { width: 100%; border-collapse: collapse; font-size: 0.91rem; }
  th {
    background: var(--bg-elevated);
    color: var(--accent-gold);
    text-align: left;
    padding: 12px 15px;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--border-strong);
  }
  td {
    padding: 11px 15px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    vertical-align: top;
  }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: rgba(255,255,255,0.02); }

  .incisos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 18px 0;
  }
  .inciso-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .inciso-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .inciso-num { font-family: var(--font-mono); font-weight: 800; font-size: 0.88rem; color: var(--text-primary); }

  .quiz-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding: 14px 16px;
    background: var(--bg-elevated);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }
  .filter-group { display: flex; flex-wrap: wrap; gap: 6px; }
  .btn-filter, .btn-action {
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.16s ease;
  }
  .btn-filter:hover, .btn-action:hover { color: var(--text-primary); border-color: var(--border-strong); }
  .btn-filter.active {
    background: var(--accent-gold-dim);
    color: var(--accent-gold);
    border-color: rgba(229,184,105,0.4);
  }
  .btn-action { border-radius: var(--radius-sm); }

  .q-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 22px;
    margin-bottom: 16px;
  }
  .q-card.answered-ok { border-color: rgba(52,211,153,0.45); }
  .q-card.answered-err { border-color: rgba(251,113,133,0.45); }
  .q-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .q-num { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; color: var(--accent-gold); }
  .q-tag {
    font-size: 0.72rem; color: var(--text-muted); background: var(--bg-surface);
    padding: 2px 9px; border-radius: 999px; border: 1px solid var(--border-subtle);
  }
  .q-stem { color: var(--text-primary); font-weight: 500; margin-bottom: 14px; font-size: 0.97rem; }
  .q-opts { display: flex; flex-direction: column; gap: 8px; }
  .q-opt {
    display: flex; align-items: flex-start; gap: 10px; width: 100%; text-align: left;
    background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);
    padding: 11px 14px; color: var(--text-secondary); font-size: 0.91rem; cursor: pointer;
    transition: all 0.15s ease; font-family: inherit; line-height: 1.5;
  }
  .q-opt:hover:not(:disabled) { background: rgba(255,255,255,0.04); border-color: var(--border-strong); color: var(--text-primary); }
  .q-opt:disabled { cursor: default; }
  .q-opt .opt-letter { font-family: var(--font-mono); font-weight: 700; color: var(--text-muted); min-width: 20px; }
  .q-opt.correct { background: var(--accent-emerald-dim); border-color: rgba(52,211,153,0.5); color: #ecfdf5; }
  .q-opt.correct .opt-letter { color: var(--accent-emerald); }
  .q-opt.wrong { background: var(--accent-rose-dim); border-color: rgba(251,113,133,0.5); color: #fff1f2; }
  .q-opt.wrong .opt-letter { color: var(--accent-rose); }
  .q-feedback {
    margin-top: 14px; padding: 14px 16px; border-radius: var(--radius-sm);
    background: rgba(11, 12, 16, 0.75); border: 1px solid var(--border-subtle);
    font-size: 0.88rem; color: var(--text-secondary); display: none;
  }
  .q-feedback.show { display: block; }
  .q-feedback strong { color: var(--accent-gold); }

  @media (max-width: 980px) {
    .app-shell { grid-template-columns: 1fr; padding: 16px 14px 60px; }
    .sidebar { position: static; }
    .scale-grid { grid-template-columns: repeat(2, 1fr); }
    .incisos-grid { grid-template-columns: 1fr; }
    .section-card, .hero { padding: 22px 18px; }
  }
  @media (max-width: 540px) { .scale-grid { grid-template-columns: 1fr; } }
  @media print {
    body { background: #fff; color: #111; }
    .sidebar, .quiz-controls, #read-progress { display: none !important; }
    .app-shell { display: block; padding: 0; }
    .section-card, .hero, .q-card { box-shadow: none; border: 1px solid #ccc; background: #fff; color: #111; }
    p, td, li, .q-opt { color: #222; }
  }
</style>
</head>
